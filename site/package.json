{
  "name": "stackward-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation and learning site for stackward, built with Astro Starlight.",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "preview": "node scripts/run.mjs preview",
    "sample": "node scripts/sample.mjs",
    "check": "node scripts/check-build.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:overflow": "node scripts/check-overflow.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.9",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "astro": "7.4.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
