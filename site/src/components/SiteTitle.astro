---
/**
 * The site title: a plain text wordmark until the brand assets land. When
 * assets/brand/logo-dark.svg and logo-light.svg exist in the repo, they are
 * inlined here and swapped by theme, with the text kept for screen readers.
 */
import { existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const brandDir = new URL('../../../assets/brand/', import.meta.url);
function logo(name: string): string | null {
  const file = fileURLToPath(new URL(name, brandDir));
  if (!existsSync(file)) return null;
  // Strip any XML prolog so the SVG can sit inline; mark it decorative.
  return readFileSync(file, 'utf8')
    .replace(/<\?xml[^>]*\?>/, '')
    .replace(/<svg\b/, '<svg aria-hidden="true" focusable="false"');
}
const dark = logo('logo-dark.svg');
const light = logo('logo-light.svg');
const home = import.meta.env.BASE_URL;
---

<a href={home} class="sw-title" aria-label="stackward, home">
  {
    dark && light ? (
      <>
        <span class="sw-logo sw-logo-dark" set:html={dark} />
        <span class="sw-logo sw-logo-light" set:html={light} />
      </>
    ) : (
      <span class="sw-wordmark">stackward</span>
    )
  }
</a>
