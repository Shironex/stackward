---
/**
 * Real stackward output in a terminal panel. The report is the CLI's own
 * report.v1 JSON (see src/samples/, written by pnpm sample), never typed by
 * hand. It is laid out like the text report, by level, with long lines
 * wrapping under the message column; the panel never scrolls sideways.
 * Level words are coloured and stay readable without colour.
 */
import { compact, fromReport } from '../lib/report.mjs';

interface Props {
  /** The command shown on the prompt line. */
  command: string;
  /** A report.v1 document (`stackward audit --json`). */
  report: object;
  /** What the reader is looking at, for the caption and screen readers. */
  caption: string;
  /** Show a short excerpt: three findings and a trimmed header. */
  brief?: boolean;
  /** A link shown after the caption. */
  more?: { href: string; label: string };
}
const { command, report: doc, caption, brief = false, more } = Astro.props;

const full = fromReport(doc);
const report = brief ? compact(full, { keys: ['host', 'profile', 'coverage'], levels: ['fail', 'warn', 'unknown'] }) : full;
const levelWord = (level: string) => level.toUpperCase();
---

<figure class:list={['terminal', 'not-content', { 'terminal-brief': brief }]}>
  <div class="terminal-bar" aria-hidden="true">
    <span class="terminal-dots"><i></i><i></i><i></i></span>
  </div>
  <div class="t-screen" role="group" aria-label={`Terminal output: ${command}`}>
    <p class="t-line"><span class="t-prompt" aria-hidden="true">$ </span><span class="t-cmd">{command}</span></p>
    {!brief && <p class="t-line t-dim">{report.title}</p>}
    {
      report.header.length > 0 && (
        <div class="t-head">
          {report.header.map((h) => (
            <>
              <span class="t-dim">{h.key ? `${h.key}:` : ''}</span>
              <span>{h.value}</span>
            </>
          ))}
        </div>
      )
    }
    {
      report.groups.map((g) => (
        <section class="t-group-block">
          {g.id && (
            <h3 class="t-group">
              {g.id}{g.name && <span> {g.name}</span>}
              {g.note && <span class="t-dim"> ({g.note})</span>}
            </h3>
          )}
          {g.findings.map((f) => (
            <div class="t-row">
              <span class={`t-level t-${f.level}`}>{levelWord(f.level)}</span>
              <span class="t-id">{f.id}</span>
              <div class="t-body">
                <p class="t-title">{f.headline}</p>
                {(f.severity || f.target) && <p class="t-msg t-dim">{[f.severity, f.target].filter(Boolean).join(' · ')}</p>}
                {!brief && f.rule && (
                  <p class="t-msg">
                    <span class="t-dim">rule:</span> <span class="t-dim">{f.rule}</span>
                  </p>
                )}
                {f.fix && (
                  <p class="t-fix">
                    <span class="t-dim">fix:</span> {f.fix}
                  </p>
                )}
              </div>
            </div>
          ))}
        </section>
      ))
    }
    {
      report.summary && (
        <p class="t-line t-summary">
          <span class="t-dim">summary:</span> {report.summary}
        </p>
      )
    }
    {report.footer.map((l) => <p class="t-line t-dim">{l}</p>)}
  </div>
  <figcaption>{caption}{more && <>{' '}<a href={more.href}>{more.label}</a></>}</figcaption>
</figure>
