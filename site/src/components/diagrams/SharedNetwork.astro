---
import Figure from './Figure.astro';
---

<Figure caption="Left: every project on one network, so a compromised app can open a connection to any other project's database. Right: one network per project; only the proxy joins each of them.">
  <svg viewBox="0 0 720 250" role="img" aria-labelledby="net-t net-d">
    <title id="net-t">One shared network compared with one network per project</title>
    <desc id="net-d">On the left, a single shared network holds app A, database A, app B and database B. A dashed red line goes from app B to database A. On the right, network A holds app A and database A, network B holds app B and database B, and the proxy is attached to both networks.</desc>
    <rect x="10" y="30" width="330" height="200" rx="6" class="d-box-fail"></rect>
    <text x="26" y="52" class="d-label">One shared network</text>
    <rect x="40" y="75" width="110" height="44" rx="4" class="d-box"></rect>
    <text x="95" y="102" text-anchor="middle" class="d-label">app A</text>
    <rect x="200" y="75" width="110" height="44" rx="4" class="d-box"></rect>
    <text x="255" y="102" text-anchor="middle" class="d-label">postgres A</text>
    <rect x="40" y="160" width="110" height="44" rx="4" class="d-box"></rect>
    <text x="95" y="187" text-anchor="middle" class="d-label">app B</text>
    <rect x="200" y="160" width="110" height="44" rx="4" class="d-box"></rect>
    <text x="255" y="187" text-anchor="middle" class="d-label">redis B</text>
    <path d="M150 165L200 115" class="d-line-fail"></path>
    <text x="118" y="148" class="d-text-fail">reachable</text>
    <rect x="380" y="30" width="155" height="200" rx="6" class="d-box-mint"></rect>
    <text x="394" y="52" class="d-label">network A</text>
    <rect x="400" y="75" width="115" height="44" rx="4" class="d-box"></rect>
    <text x="457" y="102" text-anchor="middle" class="d-label">app A</text>
    <rect x="400" y="160" width="115" height="44" rx="4" class="d-box"></rect>
    <text x="457" y="187" text-anchor="middle" class="d-label">postgres A</text>
    <rect x="555" y="30" width="155" height="200" rx="6" class="d-box-mint"></rect>
    <text x="569" y="52" class="d-label">network B</text>
    <rect x="575" y="75" width="115" height="44" rx="4" class="d-box"></rect>
    <text x="632" y="102" text-anchor="middle" class="d-label">app B</text>
    <rect x="575" y="160" width="115" height="44" rx="4" class="d-box"></rect>
    <text x="632" y="187" text-anchor="middle" class="d-label">redis B</text>
    <rect x="480" y="5" width="130" height="34" rx="4" class="d-box-strong"></rect>
    <text x="545" y="27" text-anchor="middle" class="d-label">proxy, in both</text>
  </svg>
</Figure>
