# /etc/systemd/system/stackward-audit.service
# Printed by stackward schedule --print. stackward never installs or
# enables this unit: install it by hand as docs/schedule.md shows.
[Unit]
Description=stackward read only audit
Documentation=https://github.com/Shironex/stackward/blob/main/docs/schedule.md
After=docker.service

[Service]
Type=oneshot
User=root
# Full coverage needs root. The bounding set keeps what the collectors
# use: files root does not own, the firewall ruleset (CAP_NET_ADMIN can
# also change it) and which process owns which socket. See the docs for
# what each one allows; the output directories must be owned by root.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE
ExecStart=/usr/local/bin/stackward audit --format json --fail-on never --out /var/lib/stackward/report.json.tmp --textfile /var/lib/prometheus/node-exporter/stackward.prom.tmp
# Each file is written under a temporary name and renamed into place
# (rename is atomic), and only when the audit succeeded.
ExecStartPost=/bin/mv -fT /var/lib/stackward/report.json.tmp /var/lib/stackward/report.json
ExecStartPost=/bin/mv -fT /var/lib/prometheus/node-exporter/stackward.prom.tmp /var/lib/prometheus/node-exporter/stackward.prom
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=idle
# Hardening: the audit only reads, so the whole file system is read only
# except the output directories. Nothing here hides what the audit inspects
# (no PrivateNetwork, PrivateDevices or ProtectProc).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# No collector mounts, loads modules, reboots, sets the clock, traces a
# process or touches another process's memory: those system calls fail with
# EPERM. (Writing /proc/<pid>/mem is a plain file write, which only the
# Landlock sandbox stops.)
SystemCallFilter=~@mount @module @reboot @swap @clock @cpu-emulation @obsolete @raw-io @debug process_vm_readv process_vm_writev
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/stackward /var/lib/prometheus/node-exporter
# The audit makes no network calls.
IPAddressDeny=any

# /etc/systemd/system/stackward-audit.timer
# Printed by stackward schedule --print. Enable it yourself:
#   systemctl daemon-reload && systemctl enable --now stackward-audit.timer
[Unit]
Description=Run the stackward audit on a schedule
Documentation=https://github.com/Shironex/stackward/blob/main/docs/schedule.md

[Timer]
OnCalendar=daily
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
