            "old": "",
            "new": "# Written by stackward: plan step sysctl-hardening, fixes KRN-002, KRN-003, KRN-004.\n# Hardening values only: net.ipv4.ip_forward and the other settings\n# Docker needs are never set here. Remove this file to undo at the\n# next boot.\nnet.ipv4.conf.all.rp_filter = 2\nnet.ipv4.conf.all.accept_redirects = 0\nkernel.kptr_restrict = 1\n",
            "new_sha256": "447b4d1bb1dd03c6f5c467c40f041f594f47b1d2ba54ffed0151d3460a8a5194",
            "diff": "--- /dev/null\n+++ b/etc/sysctl.d/90-stackward-hardening.conf\n@@ -0,0 +1,7 @@\n+# Written by stackward: plan step sysctl-hardening, fixes KRN-002, KRN-003, KRN-004.\n+# Hardening values only: net.ipv4.ip_forward and the other settings\n+# Docker needs are never set here. Remove this file to undo at the\n+# next boot.\n+net.ipv4.conf.all.rp_filter = 2\n+net.ipv4.conf.all.accept_redirects = 0\n+kernel.kptr_restrict = 1\n"
          }
        ],
        "commands": [
          {
            "args": [
              "sysctl",
              "-p",
              "/etc/sysctl.d/90-stackward-hardening.conf"
            ],
            "why": "apply this drop-in now, and only this file, not the whole sysctl.d tree"
