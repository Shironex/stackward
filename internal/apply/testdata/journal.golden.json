                "/etc/sysctl.d/90-stackward-hardening.conf"
              ],
              "why": "remove the drop-in"
            },
            {
              "args": [
                "sysctl",
                "-w",
                "net.ipv4.conf.all.rp_filter=1"
              ],
              "why": "restore the running value"
            },
            {
              "args": [
                "sysctl",
                "-w",
                "net.ipv4.conf.all.accept_redirects=1"
              ],
              "why": "restore the running value"
            },
            {
              "args": [
                "sysctl",
                "-w",
                "kernel.kptr_restrict=0"
              ],
              "why": "restore the running value"
            }
          ]
        },
        "notes": [
          "/etc/sysctl.conf sets kernel.kptr_restrict = 0 and is read after this drop-in, so the old value returns at boot; change it there by hand.",
